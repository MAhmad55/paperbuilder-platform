{
  "name": "paperbuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PaperBuilder — School Examination & Paper Management Platform (front-end prototype, Phase 0-1)",
  "scripts": {
    "dev": "node scripts/check-i18n.mjs && vite",
    "build": "node scripts/check-i18n.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-table": "^8.20.5",
    "i18next": "^24.2.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
